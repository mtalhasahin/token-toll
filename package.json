{
  "name": "token-tax",
  "version": "0.1.0",
  "description": "What your language costs you in tokens. Measures how many more tokens the same sentence takes in Turkish and other languages than in English, across the tokenizers real models use.",
  "keywords": ["tokenizer", "tokens", "llm", "turkish", "multilingual", "bpe", "cost", "context-window", "cli"],
  "homepage": "https://mtalhasahin.github.io/token-tax",
  "repository": { "type": "git", "url": "git+https://github.com/mtalhasahin/token-tax.git" },
  "bugs": { "url": "https://github.com/mtalhasahin/token-tax/issues" },
  "license": "MIT",
  "author": "mtalhasahin",
  "type": "module",
  "bin": { "token-tax": "dist/bin.js" },
  "exports": { ".": "./dist/index.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20.10" },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "measure": "node scripts/measure.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.7.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
